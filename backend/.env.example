PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://usuario:1234567@localhost:5432/galacticos_tickets
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=cambiar
JWT_REFRESH_SECRET=cambiar
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Si SMTP_USER y SMTP_PASS quedan vacíos, el worker crea una cuenta Ethereal automáticamente
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Poner en true durante la demo para forzar fallos de SMTP y mostrar los reintentos
SIMULAR_FALLO_SMTP=false
# Producción (Render bloquea SMTP): API HTTP de Mailtrap Sandbox. Si se definen, reemplazan a SMTP
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=
# Milisegundos mínimos entre correos (límite del proveedor). Por defecto 10000
NOTIF_INTERVALO_MS=10000
